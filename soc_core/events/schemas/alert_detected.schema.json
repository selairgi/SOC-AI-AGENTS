{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "alert_detected.schema.json",
  "title": "AlertDetected",
  "description": "Event emitted when the SOC Builder detects a potential security threat",
  "type": "object",
  "required": ["event_id", "correlation_id", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for this event instance",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "correlation_id": {
      "type": "string",
      "description": "Identifier to correlate related events across the pipeline",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp when the event was created"
    },
    "producer": {
      "type": "string",
      "description": "Identifier of the component that produced this event",
      "examples": ["soc_builder", "security_rules_engine", "intelligent_detector"]
    },
    "payload": {
      "type": "object",
      "required": ["alert_id", "severity", "threat_type", "source"],
      "properties": {
        "alert_id": {
          "type": "string",
          "description": "Unique identifier for the alert"
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Severity level of the detected threat"
        },
        "threat_type": {
          "type": "string",
          "description": "Classification of the threat type",
          "examples": ["prompt_injection", "data_exfiltration", "unauthorized_access", "model_poisoning"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score of the detection (0.0-1.0)"
        },
        "source": {
          "type": "object",
          "required": ["agent_id"],
          "properties": {
            "agent_id": {
              "type": "string",
              "description": "Identifier of the monitored agent"
            },
            "user_id": {
              "type": "string",
              "description": "Identifier of the user involved"
            },
            "src_ip": {
              "type": "string",
              "description": "Source IP address"
            },
            "session_id": {
              "type": "string",
              "description": "Session identifier"
            }
          }
        },
        "evidence": {
          "type": "object",
          "description": "Evidence supporting the detection",
          "properties": {
            "matched_patterns": {
              "type": "array",
              "items": { "type": "string" }
            },
            "raw_input": {
              "type": "string",
              "description": "The input that triggered the alert"
            },
            "detection_method": {
              "type": "string",
              "enum": ["pattern_matching", "semantic_analysis", "behavioral", "hybrid"]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
