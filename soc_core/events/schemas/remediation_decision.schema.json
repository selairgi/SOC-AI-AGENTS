{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "remediation_decision.schema.json",
  "title": "RemediationDecision",
  "description": "Final consensus decision aggregating inputs from multiple agents",
  "type": "object",
  "required": ["event_id", "correlation_id", "timestamp", "producer", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for this event instance",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "correlation_id": {
      "type": "string",
      "description": "Identifier to correlate related events across the pipeline",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO8601 timestamp when the event was created"
    },
    "producer": {
      "type": "string",
      "description": "Identifier of the component that produced this event",
      "const": "consensus_agent"
    },
    "payload": {
      "type": "object",
      "required": ["decision_id", "action", "confidence", "contributors"],
      "properties": {
        "decision_id": {
          "type": "string",
          "description": "Unique identifier for this consensus decision"
        },
        "alert_id": {
          "type": "string",
          "description": "Reference to the original alert"
        },
        "action": {
          "type": "string",
          "enum": ["execute", "require_human", "block", "monitor", "ignore"],
          "description": "The consensus action to take"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence in the consensus decision (0.0-1.0)"
        },
        "urgency": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Urgency level for acting on this decision"
        },
        "reasoning": {
          "type": "string",
          "description": "Human-readable explanation of the consensus decision"
        },
        "contributors": {
          "type": "object",
          "description": "Contributions from each agent to the decision",
          "properties": {
            "risk_agent": {
              "type": "object",
              "properties": {
                "received": { "type": "boolean" },
                "weight": { "type": "number" },
                "vote": { "type": "string" },
                "weighted_score": { "type": "number" },
                "details": {
                  "type": "object",
                  "properties": {
                    "risk_level": { "type": "string" },
                    "risk_score": { "type": "number" },
                    "recommendations": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            },
            "policy_agent": {
              "type": "object",
              "properties": {
                "received": { "type": "boolean" },
                "weight": { "type": "number" },
                "vote": { "type": "string" },
                "weighted_score": { "type": "number" },
                "details": {
                  "type": "object",
                  "properties": {
                    "decision": { "type": "string" },
                    "reason": { "type": "string" },
                    "matched_rules": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            },
            "analyst": {
              "type": "object",
              "properties": {
                "received": { "type": "boolean" },
                "weight": { "type": "number" },
                "vote": { "type": "string" },
                "weighted_score": { "type": "number" },
                "details": {
                  "type": "object",
                  "properties": {
                    "verdict": { "type": "string" },
                    "certainty": { "type": "number" },
                    "recommended_action": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "voting_summary": {
          "type": "object",
          "description": "Summary of the weighted voting process",
          "properties": {
            "total_weight": { "type": "number" },
            "votes_received": { "type": "integer" },
            "votes_expected": { "type": "integer" },
            "consensus_threshold": { "type": "number" },
            "consensus_reached": { "type": "boolean" },
            "vote_breakdown": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          }
        },
        "incomplete_reason": {
          "type": "string",
          "description": "If decision was made with incomplete inputs, explains why"
        }
      }
    }
  },
  "additionalProperties": false
}
