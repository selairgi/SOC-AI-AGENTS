# Enhanced SOC AI Agents - Environment Configuration

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Flask Configuration
SECRET_KEY=your_secret_key_here_change_in_production
FLASK_ENV=production

# Security Configuration
REAL_MODE=True
DRY_RUN=True
ENABLE_SCHEMA_VALIDATION=True
ENABLE_ACTION_WHITELIST=True
ENABLE_INPUT_SANITIZATION=True

# =============================================================================
# DEPLOYMENT MODE CONFIGURATION
# =============================================================================
# Available modes:
#   - "local"      : Local development (no Cloudflare)
#   - "tunnel"     : Cloudflare Tunnel (FREE) - exposes local server via cloudflared
#   - "cloudflare" : Full Cloudflare with WAF API (PAID) - blocks IPs at edge
#
# TUNNEL MODE (Recommended for free public access):
#   - Uses Cloudflare Tunnel (cloudflared) to expose your local server
#   - Real client IP from CF-Connecting-IP header (validated)
#   - IP blocking done locally at application level
#   - HTTPS provided by Cloudflare externally (Flask runs on HTTP internally)
#   - ProxyFix middleware makes Flask recognize HTTPS from X-Forwarded-Proto
#   - WebSocket works through the tunnel (polling + upgrade)
#   - Session cookies marked as Secure (SameSite=None for cross-origin)
#   - No API keys needed!
#
# CLOUDFLARE MODE (Paid tier):
#   - Requires CLOUDFLARE_ZONE_ID and CLOUDFLARE_API_TOKEN
#   - IP blocking at Cloudflare edge via WAF API (faster, more secure)
#   - All tunnel features plus edge-level blocking
#
DEPLOYMENT_MODE=local

# =============================================================================
# CLOUDFLARE CONFIGURATION (required when DEPLOYMENT_MODE=cloudflare)
# =============================================================================
# Get these from your Cloudflare dashboard:
# 1. Go to your domain's Overview page
# 2. Find "Zone ID" in the right sidebar (API section)
# 3. Go to "Manage Account" > "API Tokens" to create a token

# Cloudflare Zone ID (found in dashboard under your domain)
# CLOUDFLARE_ZONE_ID=your_zone_id_here

# Cloudflare API Token with these permissions:
# - Zone > Firewall Services > Edit (for WAF rules)
# - Zone > Zone > Read (for zone info)
# CLOUDFLARE_API_TOKEN=your_api_token_here

# Optional: Account ID (for account-level rules, usually not needed)
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# =============================================================================
# CORS CONFIGURATION (for Cloudflare deployment)
# =============================================================================
# Comma-separated list of allowed origins for WebSocket connections
# Use "*" to allow all (less secure) or specify your domain(s)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
# Secure cookies are auto-enabled in both Tunnel and Cloudflare modes
# ProxyFix middleware makes Flask recognize HTTPS from Cloudflare Tunnel
# Note: Do NOT set SESSION_COOKIE_SECURE manually unless you know what you're doing
# SESSION_COOKIE_SECURE=True  # Auto-set based on deployment mode

# Cookie domain for subdomain sharing (optional)
# COOKIE_DOMAIN=.yourdomain.com

# Optional: Redis Configuration (for scaling/session storage)
# REDIS_URL=redis://localhost:6379/0

# Optional: Database Configuration
# DATABASE_URL=sqlite:///soc_agents.db

# Logging Configuration
LOG_LEVEL=INFO

# CTF Challenge Configuration
CTF_FLAG=FindinaJ0binthebiG2025IsNOTf04th3eak
